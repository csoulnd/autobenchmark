{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "state",
    "target",
    "model",
    "instances",
    "kv_transfer",
    "proxy",
    "benchmark",
    "policies",
    "unresolved"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[\\w-]+$"
    },
    "state": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "container",
        "work_dir",
        "image_id"
      ],
      "properties": {
        "host": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "container": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "work_dir": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[^\\r\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "image_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "served_name",
        "max_model_len"
      ],
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[^\\r\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "served_name": {
          "type": "string",
          "minLength": 1
        },
        "max_model_len": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "instances": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "dp",
          "tp",
          "ep",
          "device_ids",
          "port",
          "dp_rpc_port",
          "kv_port",
          "engine_id",
          "script"
        ],
        "properties": {
          "role": {
            "enum": [
              "prefill",
              "decode"
            ]
          },
          "dp": {
            "type": "integer",
            "minimum": 1
          },
          "tp": {
            "type": "integer",
            "minimum": 1
          },
          "ep": {
            "type": "boolean"
          },
          "device_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "dp_rpc_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "kv_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "engine_id": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "pattern": "^/[^\\r\\n]+$"
          }
        }
      }
    },
    "kv_transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connector",
        "prefill",
        "decode"
      ],
      "properties": {
        "connector": {
          "type": "string",
          "minLength": 1
        },
        "prefill": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dp",
            "tp"
          ],
          "properties": {
            "dp": {
              "type": "integer",
              "minimum": 1
            },
            "tp": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "decode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dp",
            "tp"
          ],
          "properties": {
            "dp": {
              "type": "integer",
              "minimum": 1
            },
            "tp": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "script"
      ],
      "properties": {
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "script": {
          "type": "string",
          "pattern": "^/[^\\r\\n]+$"
        }
      }
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_dir",
        "aisbench_work_path",
        "prefix_caching",
        "prefill_dp",
        "rounds",
        "cases"
      ],
      "properties": {
        "tool_dir": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[^\\r\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "aisbench_work_path": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^/[^\\r\\n]+$"
            },
            {
              "type": "null"
            }
          ]
        },
        "prefix_caching": {
          "type": "boolean"
        },
        "prefill_dp": {
          "type": "integer",
          "minimum": 1
        },
        "rounds": {
          "type": "integer",
          "minimum": 1
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "input_tokens",
              "output_tokens",
              "concurrency",
              "formal_requests",
              "prefix_ratio",
              "prefix_num",
              "seed",
              "request_rate",
              "warmup",
              "timeout_seconds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "input_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "output_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "concurrency": {
                "type": "integer",
                "minimum": 1
              },
              "formal_requests": {
                "type": "integer",
                "minimum": 1
              },
              "prefix_ratio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "prefix_num": {
                "type": "integer",
                "minimum": 1
              },
              "seed": {
                "type": "integer"
              },
              "request_rate": {
                "type": "number",
                "minimum": 0
              },
              "warmup": {
                "type": "boolean"
              },
              "timeout_seconds": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_exclusive_npu",
        "require_pd_smoke",
        "reject_sse_errors",
        "cleanup_owned_only",
        "allow_spec_reduction"
      ],
      "properties": {
        "require_exclusive_npu": {
          "const": true
        },
        "require_pd_smoke": {
          "const": true
        },
        "reject_sse_errors": {
          "const": true
        },
        "cleanup_owned_only": {
          "const": true
        },
        "allow_spec_reduction": {
          "const": false
        }
      }
    },
    "unresolved": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
