{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "3.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^\\d{8}-\\d{3}(?:-\\d{3})?$"
    },
    "state": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "host"
      ]
    },
    "deployments": {
      "type": "array",
      "minItems": 1,
      "maxItems": 999,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "image": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
              },
              "served_name": {
                "type": "string",
                "minLength": 1
              },
              "max_model_len": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "served_name",
              "max_model_len"
            ]
          },
          "npu_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "container": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "shm_size": {
                "type": "string",
                "minLength": 1
              },
              "privileged": {
                "type": "boolean"
              }
            },
            "required": [
              "shm_size",
              "privileged"
            ]
          },
          "ports": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "additionalProperties": {
              "type": "integer",
              "minimum": 1,
              "maximum": 256
            }
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
                },
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "anyOf": [
                      {
                        "type": "string",
                        "minLength": 1
                      },
                      {
                        "type": "object",
                        "additionalProperties": false,
                        "properties": {
                          "json": {}
                        },
                        "required": [
                          "json"
                        ]
                      }
                    ]
                  }
                },
                "env": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "bootstrap": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "argv"
              ]
            }
          },
          "service": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "health_urls": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "endpoint": {
                "type": "string",
                "minLength": 1
              },
              "gateway_health_url": {
                "type": "string",
                "minLength": 1
              },
              "reset_ports": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "prefill_port": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "health_urls",
              "endpoint",
              "reset_ports",
              "prefill_port"
            ]
          },
          "prefill_dp": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "id",
          "image",
          "model",
          "npu_ids",
          "container",
          "ports",
          "commands",
          "service",
          "prefill_dp"
        ]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deployment_id",
          "input_tokens",
          "output_tokens",
          "concurrency",
          "prefix_ratio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          },
          "input_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "output_tokens": {
            "type": "integer",
            "minimum": 1
          },
          "concurrency": {
            "type": "integer",
            "minimum": 1
          },
          "formal_requests": {
            "type": "integer",
            "minimum": 1
          },
          "prefix_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "prefix_num": {
            "type": "integer",
            "minimum": 1
          },
          "seed": {
            "type": "integer"
          },
          "request_rate": {
            "type": "number",
            "minimum": 0
          },
          "warmup": {
            "const": true
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1
          },
          "reset_cache": {
            "type": "boolean"
          },
          "deployment_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke": {
          "const": "default",
          "default": "default"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 3
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "smoke_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after_case": {
          "enum": [
            "keep_service",
            "stop_service",
            "stop_container"
          ]
        },
        "task_end": {
          "enum": [
            "keep_service",
            "stop_service",
            "stop_container"
          ]
        }
      },
      "required": [
        "after_case",
        "task_end"
      ]
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "state",
    "target",
    "deployments",
    "cases",
    "unresolved"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
