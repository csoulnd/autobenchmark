{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "job_id": {
      "type": "string",
      "pattern": "^\\d{8}-\\d{3}(?:-\\d{3})?$"
    },
    "state": {
      "enum": [
        "draft",
        "ready"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "work_dir": {
          "type": "string",
          "pattern": "^/[^\\r\\n]+$"
        },
        "image": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "host",
        "container",
        "work_dir",
        "image"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\r\\n]+$"
        },
        "served_name": {
          "type": "string",
          "minLength": 1
        },
        "max_model_len": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "path",
        "served_name",
        "max_model_len"
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shm_size": {
          "type": "string",
          "minLength": 1
        },
        "privileged": {
          "type": "boolean"
        },
        "devices": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^/[^\\r\\n]+$"
          }
        },
        "mounts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "source": {
                "type": "string",
                "pattern": "^/[^\\r\\n]+$"
              },
              "target": {
                "type": "string",
                "pattern": "^/[^\\r\\n]+$"
              },
              "read_only": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "target",
              "read_only"
            ]
          }
        }
      },
      "required": [
        "shm_size",
        "privileged",
        "devices",
        "mounts"
      ]
    },
    "deployment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recipe": {
          "type": "string",
          "pattern": "^assets/[a-zA-Z0-9_-]+$"
        },
        "parameters": {
          "type": "object"
        }
      },
      "required": [
        "recipe",
        "parameters"
      ]
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "adapter": {
          "const": "aisbench_prefix"
        },
        "tool_dir": {
          "type": "string",
          "pattern": "^/[^\\r\\n]+$"
        },
        "aisbench_work_path": {
          "type": "string",
          "pattern": "^/[^\\r\\n]+$"
        },
        "prefill_dp": {
          "type": "integer",
          "minimum": 1
        },
        "case": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "input_tokens",
            "output_tokens",
            "concurrency",
            "formal_requests",
            "prefix_ratio",
            "prefix_num",
            "seed",
            "request_rate",
            "warmup",
            "timeout_seconds",
            "reset_cache"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
            },
            "input_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "output_tokens": {
              "type": "integer",
              "minimum": 1
            },
            "concurrency": {
              "type": "integer",
              "minimum": 1
            },
            "formal_requests": {
              "type": "integer",
              "minimum": 1
            },
            "prefix_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "prefix_num": {
              "type": "integer",
              "minimum": 1
            },
            "seed": {
              "type": "integer"
            },
            "request_rate": {
              "type": "number",
              "minimum": 0
            },
            "warmup": {
              "const": true
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "reset_cache": {
              "type": "boolean"
            }
          }
        }
      },
      "required": [
        "adapter",
        "tool_dir",
        "aisbench_work_path",
        "prefill_dp",
        "case"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smoke": {
          "const": "default",
          "default": "default"
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 3
        },
        "startup_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "smoke_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": []
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "after_case": {
          "enum": [
            "keep_service",
            "stop_service",
            "stop_container"
          ]
        },
        "task_end": {
          "enum": [
            "keep_service",
            "stop_service",
            "stop_container"
          ]
        }
      },
      "required": [
        "after_case",
        "task_end"
      ]
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "state",
    "target",
    "model",
    "container",
    "deployment",
    "benchmark",
    "cleanup",
    "unresolved"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
